<JavaSound>
    <default>
        <network>
            <parameter name="in" type="boolean" value="true"/>
            <parameter name="out" type="boolean" value="true"/>
            <parameter name="share" type="boolean" value="true"/>
            <parameter name="origin" type="string" value="123"/>
        </network>
        <media>
            <tone name="dial" value="250,400,125,400,125,0,0,0,0,0"/>
            <tone name="busy" value="253,500,200,0,0,55,40,55,40,4"/>
            <tone name="ringback" value="254,450,150,0,0,150,100,550,400,0"/>
            <tone name="disconnect" value="257,900,700,0,0,90,70,90,70,2"/>
            <format type="record" value="LINEAR16/11025"/>
            <format type="play" value="LINEAR16/11025"/>
        </media>
    </default>
    <device name="SoundCard" type="analog">
        <network>
            <parameter name="in" type="boolean" value="true"/>
            <parameter name="out" type="boolean" value="true"/>
            <parameter name="fax" type="boolean" value="true"/>
            <parameter name="share" type="boolean" value="false"/>
            <parameter name="origin" type="string" value="+1234567890"/>
        </network>
        <media>
            <tone name="dial" value="50,400,125,400,125,0,0,0,0,0"/>
            <tone name="busy" value="53,500,200,0,0,55,40,55,40,4"/>
            <tone name="ringback" value="54,450,150,0,0,150,100,550,400,0"/>
            <tone name="disconnect" value="57,900,700,0,0,90,70,90,70,2"/>
            <format type="record" value="LINEAR/8000"/>
            <format type="play" value="LINEAR/8000"/>
        </media>
    </device>
</JavaSound>

